# Telegram Bot Configuration
BOT_TOKEN=your_telegram_bot_token_here

# Active Directory Domain Controller Configuration
AD_SERVER=192.168.201.15
AD_DOMAIN=kdb.kz
AD_USER=dcadm01@kdb.kz
AD_PASSWORD=your_ad_service_password_here
AD_SEARCH_BASE=DC=kdb,DC=kz

# Workstation Admin Credentials (member of RemoteAdmins / KdbPCAdm for WinRM & C$)
# Optional: falls back to AD_USER / AD_PASSWORD if omitted
PC_ADMIN_USER=
PC_ADMIN_PASSWORD=

# IBM Lotus Notes ID Manager (SMB storage share)
LOTUS_STORAGE_UNC=\\storage\public\id
LOTUS_NOTES_SUBPATH=AppData\Local\IBM\Notes\Data
LOTUS_STORAGE_USER=
LOTUS_STORAGE_PASSWORD=

# Target AD Organizational Units (optional overrides; TARGET_PC_OUS uses ';' separator)
# TARGET_PC_OUS=OU=KDB Computers,DC=kdb,DC=kz;OU=KDB Nout,DC=kdb,DC=kz;CN=Servers,DC=kdb,DC=kz
TARGET_PC_MOVE_OU=OU=KDB notebooklenovo,OU=KDB Nout,DC=kdb,DC=kz
CERT_USER_OU=OU=notebooklenovo,OU=Bank Divisions,OU=KDB Users,DC=kdb,DC=kz

# Zoom Server-to-Server OAuth (optional)
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

# Audit & Logging
LOG_CHAT_ID=-100xxxxxxxxxx

# Whitelist of Telegram Admin User IDs (comma-separated)
ADMIN_IDS=6133663021, 1321779177
